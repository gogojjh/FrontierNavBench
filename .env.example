# Copy to .env. Keep credentials private; every template value is intentionally empty.
# Astra and Qwen credentials (needed only by the corresponding image-goal methods).
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=

# Optional path overrides; empty selects this checkout's data/ and assets/.
VNAV_DATA_DIR=
VNAV_ASSET_DIR=
VNAV_ENV_FILE=

# Simulator defaults to localhost. Remote hosts read their own .env.
VNAV_DESKTOP_HOST=
VNAV_DESKTOP_REPO=
VNAV_SIM_PYTHON=
VNAV_SRU_PYTHON=
VNAV_CONDA=
VNAV_SIM_ENV=
VNAV_SRU_ENV=
